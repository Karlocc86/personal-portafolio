{
  "name": "karlo-cadena-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node build-server/server.js",
    "test": "npm run build && node --test tests/server.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
